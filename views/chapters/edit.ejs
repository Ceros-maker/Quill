<h1>Edit Chapter</h1>
<p class="meta">from <a href="/stories/<%= story.id %>"><%= story.title %></a></p>

<div class="card">
  <% if (typeof error !== 'undefined' && error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <form method="POST" action="/stories/<%= story.id %>/chapters/<%= chapter.id %>/edit">
    <label>Chapter Title</label>
    <input type="text" name="title" value="<%= chapter.title %>" required />

    <label>Content</label>
    <textarea name="content" rows="12" required><%= chapter.content %></textarea>

    <div class="form-actions">
      <button type="submit" class="btn">Save Changes</button>
      <a href="/stories/<%= story.id %>/chapters/<%= chapter.id %>" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>