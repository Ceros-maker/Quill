<div class="page-header">
  <h1>Stories</h1>
  <% if (typeof user !== 'undefined' && user) { %>
    <a href="/stories/new" class="btn">+ New Story</a>
  <% } %>
</div>

<% if (stories.length === 0) { %>
  <div class="empty">
    <p>No stories yet.</p>
    <% if (typeof user !== 'undefined' && user) { %>
      <a href="/stories/new" class="btn">Write the first one</a>
    <% } else { %>
      <p><a href="/register">Register</a> to write a story.</p>
    <% } %>
  </div>
<% } else { %>
  <% for (const story of stories) { %>
    <article class="story-card">
      <% if (story.cover_url) { %>
        <img src="<%= story.cover_url %>" alt="" style="max-width: 200px; border-radius: 8px; margin-bottom: 12px;" />
      <% } %>
      <h2><a href="/stories/<%= story.id %>"><%= story.title %></a></h2>
      <p class="meta">by <%= story.author_username %></p>
      <% if (story.description) { %>
        <p><%= story.description %></p>
      <% } %>
    </article>
  <% } %>
<% } %>